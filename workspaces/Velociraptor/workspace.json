{
  "friendly_name": "Velociraptor",
  "description": "Launch Instant Velociraptor in an isolated, temporary Kasm session.",
  "image_src": "velociraptor.svg",
  "categories": [
    "Security",
    "Forensics"
  ],
  "architecture": [
    "amd64"
  ],
  "docker_registry": "https://ghcr.io",
  "cores": 2,
  "memory": 4096,
  "gpu_count": 0,
  "cpu_allocation_method": "Inherit",
  "run_config": {
    "hostname": "kasm-velociraptor",
    "shm_size": "2gb"
  },
  "notes": "Velociraptor Instant Mode: admin/password. The server listens only within the container, and the data is deleted when the session ends.",
  "compatibility": [
    {
      "version": "1.19.x",
      "image": "ghcr.io/shyr0x77/kasm-velociraptor:1.19.0",
      "uncompressed_size_mb": 5000
    }
  ]
}
